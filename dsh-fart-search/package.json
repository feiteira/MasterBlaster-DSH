{
  "name": "dsh-fart-search",
  "version": "0.1.0",
  "description": "FART (Find And Retrieve Text) workspace search for the DeepSeek Harness Web GUI",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/policy.js",
    "lib/search.js",
    "lib/client.js"
  ],
  "scripts": {
    "test": "node test/policy.test.mjs && node test/search.test.mjs && node test/host.test.mjs && node test/client.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7"
  },
  "license": "MIT"
}
