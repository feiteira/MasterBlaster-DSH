{
  "name": "dsh-file-explorer",
  "version": "0.1.0",
  "description": "Workspace file explorer for the DeepSeek Harness Web GUI: browse, upload, download, and drag-and-drop",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/policy.js",
    "lib/zip.js",
    "lib/client.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7"
  },
  "license": "MIT"
}
